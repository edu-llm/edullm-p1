# Token selection 370M FarmShare profile.
EXPERIMENT_SLUG="token-selection-370m"
STAGE_ROOT_REL="inputs/token-selection"
DATASET_VERSION="v1"
REFHQ_VERSION="v3"
EVAL_REQUIREMENTS="requirements-token-selection-eval.txt"
# Every reported arm runs on one FarmShare 4xL40S node (recipe.py's
# PRODUCTION_WORLD_SIZE). Production never sets TRAIN_GPUS itself, so this
# default is what every reported run actually uses; a smoke test can export
# TRAIN_GPUS to a different count (with EDULLM_LOCAL=1, which is never set
# automatically either).
TRAIN_GPUS="${TRAIN_GPUS:-4}"
TRAIN_CPUS="${TRAIN_CPUS:-32}"
TRAIN_MEM="${TRAIN_MEM:-64G}"
TRAIN_TIME="${TRAIN_TIME:-24:00:00}"
# Staging is local file verification only (no download): a single CPU task.
STAGE_CPUS="${STAGE_CPUS:-2}"
STAGE_MEM="${STAGE_MEM:-8G}"
STAGE_TIME="${STAGE_TIME:-00:30:00}"
